{
  "name": "jeongho-nest",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "db:migration:generate": "pnpm --filter @jeongho-nest/db migration:generate",
    "db:migration:run": "pnpm --filter @jeongho-nest/db migration:run"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "turbo": "^2.9.14"
  }
}
